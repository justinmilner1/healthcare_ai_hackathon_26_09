# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sweetspot
# The app is Postgres only (design §3.2), but a SQLite file left over from before the switch still holds whatever
# was in it. Keep the guard so one can never be committed by accident.
*.db
*.db-journal
data/*
!data/*_sample.*
!data/visits.csv
!data/README.md
# Test fixtures are synthetic by construction and are the inputs every parser test reads (design §9.4).
!data/fixtures/

# The local mail drop: with no email provider configured, lib/mailer.ts writes sign-in links here instead of
# sending them (design §5.1). They are credentials, so they never get committed. `npm run mail` reads it.
.mail/
# Every mailbox, not just the one: the e2e suite runs a second server with its own (e2e/.mail-degraded,
# playwright.config.ts), and the narrower `e2e/.mail/` let two of its sign-in links be committed by a
# `git add -A` on the T06 branch. The glob covers whatever the next server calls its drop.
e2e/.mail*/

# local tooling
.claude/

# e2e
e2e/screenshots/
e2e/report/
e2e/test-results/
test-results/
