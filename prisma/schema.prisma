// Sweet Spot data model (design §3.2, §3.4, §4). Postgres everywhere: `docker compose up db` locally, RDS in AWS.
// Visit-centric (§4.4): a Patient persists across visits; intake, messages, uploads and summaries hang off a
// Visit. The Dexcom connection stays per patient (§4.10). Parsed uploads are JSON strings in the shapes from
// lib/types.ts. The one-time conversion from the hackathon shape is in prisma/migrations and lib/migrateVisits.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// §4.1 One clinic. retentionDays drives the nightly retention sweep (§10.4).
// `isDemo` marks a practice as synthetic (§13.4): its visits are left alone by the nightly sweep, its log
// lines carry `demo: true` so §11.1's alarms can leave them out, and nothing it sends may reach an address
// that is not itself synthetic (lib/demo.ts). Default false, because a practice somebody signed up for is
// real until an operator says otherwise.
model Practice {
  id            String     @id @default(cuid())
  name          String
  retentionDays Int        @default(365)
  isDemo        Boolean    @default(false)
  createdAt     DateTime   @default(now())
  users         User[]
  patients      Patient[]
  auditLogs     AuditLog[]
}

// §4.2 A clinician, admin or staff member. `name` and `image` are nullable because the Auth.js
// adapter (§5.1, landing in T05) creates users from the email link before anyone has typed a name.
model User {
  id            String    @id @default(cuid())
  practiceId    String
  practice      Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          String    @default("staff") // admin | clinician | staff (§5.2)
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  visits        Visit[]   @relation("VisitProvider")

  @@index([practiceId])
}

// Auth.js tables (§4.2). Field names are fixed by the adapter; do not rename them.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// A signed-in provider's session (§5.1). Not to be confused with PatientSession (§4.5).
// `expires` is the 12-hour idle clock: Auth.js rolls it forward on each request. `createdAt` never moves, so
// it is the 7-day absolute cap that lib/authAdapter.ts enforces when the session is read.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// §4.3 A person. Persists across visits; `deletedAt` is set by the deletion action (§10.5).
model Patient {
  id         String    @id @default(cuid())
  practiceId String
  practice   Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  // §8.1 Why we stop messaging this person on a channel, as the provider told us rather than as we guessed.
  // `emailUndeliverableAt` is set by an SES bounce or complaint notification (lib/notifyStore.ts) and
  // `emailUndeliverableReason` says which: an address that hard-bounced is wrong, and one that complained
  // asked us to stop — SES counts both against the sending domain, so both stop the sends.
  // `smsOptOutAt` is the patient texting STOP, which AWS honors in its own opt-out list; recording it here is
  // what stops us queueing a message that would be dropped, and what staff can see on the dashboard.
  emailUndeliverableAt     DateTime?
  emailUndeliverableReason String? // bounce | complaint
  smsOptOutAt              DateTime?

  visits           Visit[]
  dexcomConnection DexcomConnection?

  @@index([practiceId])
}

// §4.4 One appointment. The invite token identifies the visit (§5.3); everything the patient gives us
// during intake hangs off this row. `optIn` and `isSandbox` are per-invite, so they live here too.
model Visit {
  id             String    @id @default(cuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerUserId String?
  providerUser   User?     @relation("VisitProvider", fields: [providerUserId], references: [id])
  scheduledAt    DateTime?
  visitType      String? // new_patient | follow_up | medication | post_hospital | annual (lib/sweetie.ts)
  reason         String? // what the patient called in about, in the scheduler's words
  status         String    @default("invited") // invited | verified | in_intake | intake_done | summary_ready | reviewed | cancelled

  token          String    @unique // presigned link: /s/<token>
  tokenExpiresAt DateTime?

  // §2.2 Which channels the invite goes out on: both | sms | email | none. Null on rows created before T07,
  // which lib/visitIntake.ts reads as "both", the behaviour those rows were created with.
  contactChannel String?

  // §2.2 The practice's record of the patient agreeing to be contacted, taken by staff when the visit is made.
  consentRecordedBy String?
  consentRecordedAt DateTime?
  consentChannel    String?

  // §2.4 The patient's own one-tap consent on the screen in front of the intake, a different thing from the
  // three fields above: that one is staff saying "we may text them", this one is the patient saying "you may
  // collect this". Accepting is what opens the patient pages; declining ends the session (lib/consent.ts).
  // Both timestamps can be set, in which case the patient declined and later changed their mind.
  intakeConsentAt         DateTime?
  intakeConsentDeclinedAt DateTime?

  reviewedBy String?
  reviewedAt DateTime?

  // §10.4 When the nightly retention sweep removed this visit's data. Set once, by lib/retentionStore.ts, and
  // what keeps the next sweep from picking the same visit up again: the row itself stays — the appointment
  // happened, and the audit record of the deletion points at it — but intake, notes, messages, uploads and
  // summaries are gone. Null on every visit inside the practice's retention window, which is nearly all of them.
  retentionSweptAt DateTime?

  notes  String? // Sweetie's collected answers rendered as text for Sour
  intake String? // Sweetie's structured IntakeState as JSON (lib/types.ts)

  optIn     Boolean  @default(false)
  isSandbox Boolean  @default(false)
  createdAt DateTime @default(now())

  sessions          PatientSession[]
  deliveries        VisitDelivery[]
  uploads           Upload[]
  messages          Message[]
  summaries         Summary[]
  followUps         FollowUp[]
  dexcomOAuthStates DexcomOAuthState[]

  @@index([patientId])
  @@index([providerUserId])
  @@index([retentionSweptAt])
}

// §8.3 What one message to this visit did: "Delivery results are recorded on the visit (channel, provider
// message id, status) and shown to staff." One row per message kind, channel and audience, replaced by each
// send, because staff want "did the last thing we sent reach them" and lib/log.ts already has every attempt.
//
// `kind` and `audience` are in the key as well as the channel (T19). The invite and the summary notice are
// two different questions on the dashboard — "did they get their link" and "was the clinician told the
// summary is ready" — and the summary goes to two people over the same channel, so keying on the channel
// alone made the second email overwrite the first.
//
// `status` carries what the provider later said as well as what the send did: a `sent` row becomes
// `bounced` or `complained` when SES's notification topic reports on that `providerMessageId`
// (lib/notifyStore.ts), which is the whole reason the id is stored.
// `error` is operational text (SES's refusal, "no phone on file", a bounce subtype), never an address or a
// message body (§10.3).
model VisitDelivery {
  id                String   @id @default(cuid())
  visitId           String
  visit             Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  channel           String // sms | email
  // The job that sent it. The verification code is not one of them: it is a message with a life of ten
  // minutes, recorded in the audit log (§10.2) rather than on a dashboard that would still be showing it
  // long after it stopped meaning anything.
  kind              String // notify.invite | notify.summary
  audience          String   @default("patient") // patient | provider — who the message went to (§8.2)
  status            String // sent | failed | skipped | bounced | complained
  providerName      String? // ses | sns | resend | twilio
  providerMessageId String?
  error             String?
  at                DateTime @default(now())

  @@unique([visitId, kind, channel, audience])
  @@index([visitId])
  // How a bounce or complaint notification finds the row it is about: SES hands back a message id at send
  // time and quotes it minutes later (§8.3).
  @@index([providerMessageId])
}

// §4.5 A verified patient browser session. Only the hash of the six-digit code is stored.
model PatientSession {
  id            String    @id @default(cuid())
  visitId       String
  visit         Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  codeHash      String
  codeExpiresAt DateTime
  verifiedAt    DateTime?
  expiresAt     DateTime
  attempts      Int       @default(0)

  @@index([visitId])
}

// §4.6 One uploaded file. `kind` is dexcom | timeline | whoop | visits. `s3Key` is where the raw bytes live
// (S3 in deployed environments, the filesystem in development and CI — lib/storage.ts, §3.3); it is null only
// for rows written before T11. The parsed rows live in the UploadData row beside it.
model Upload {
  id         String      @id @default(cuid())
  visitId    String
  visit      Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  kind       String
  filename   String
  s3Key      String?
  bytes      Int         @default(0)
  parsedRows Int         @default(0)
  createdAt  DateTime    @default(now())
  data       UploadData?

  @@index([visitId, kind])
}

// §4.6 The heavy half of an upload, kept out of Upload so the main table stays small.
// `parsed` is JSON: GlucoseReading[] | Visit[] | SleepNight[] (lib/types.ts). The raw bytes are not here and
// never were meant to be (§3.3): they are in object storage under `Upload.s3Key`.
model UploadData {
  uploadId String @id
  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  parsed   String
}

// §4.7 Sweetie chat transcript. role is sweetie | patient.
model Message {
  id        String   @id @default(cuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([visitId])
}

// §4.7 Generated summaries. audience is provider | patient. json is a Summary (lib/types.ts).
// `inputHash` is the fingerprint of the intake and uploads this summary was generated from (§7.1,
// lib/sourRun.ts sourInputHash): a second run over unchanged inputs finds the pair and returns it instead
// of spending two model calls. Null means "do not reuse me" — the narrative is a placeholder from a run the
// model gateway was down for, and the next run must really run.
model Summary {
  id         String    @id @default(cuid())
  visitId    String
  visit      Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  audience   String
  json       String
  inputHash  String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([visitId, audience])
  @@index([visitId, inputHash])
}

// §7.5 One follow-up question a clinician asked Sour about this visit, and the answer they were given.
// "Logged with the clinician id and the answer, visible on the page, never emailed": the log is this table,
// the page reads it back through GET /api/sour (lib/followUps.ts), and no notification template takes it
// (lib/notify.ts). `askedBy` is the clinician's user id with no foreign key, like `Visit.reviewedBy` and
// `AuditLog.actorId`: the record outlives the account and the name is joined at read time.
// `answer` is null until the model answers — the question is written before the call (§6.2's rule for
// Sweetie), so an outage leaves the question on the record rather than losing what was asked.
model FollowUp {
  id         String    @id @default(cuid())
  visitId    String
  visit      Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  askedBy    String?
  question   String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([visitId, createdAt])
}

// §4.8 Who did what. `detail` is JSON and carries no PHI (§10.3).
model AuditLog {
  id         String   @id @default(cuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  actorType  String // user | patient | system
  actorId    String?
  action     String
  entityType String
  entityId   String?
  at         DateTime @default(now())
  detail     String? // JSON

  @@index([practiceId, at])
  @@index([entityType, entityId])
}

// §3.4, §4.9 Background work. The runner drains due rows; three attempts, then failed with the error kept.
model Job {
  id             String    @id @default(cuid())
  kind           String // sour.run | notify.invite | notify.code | notify.summary | patient.delete | retention.sweep
  payload        String    @default("{}") // JSON
  status         String    @default("queued") // queued | running | done | failed
  attempts       Int       @default(0)
  runAfter       DateTime  @default(now())
  lastError      String?
  idempotencyKey String?   @unique
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAfter])
}

// §4.10 OAuth secrets never leave the server. Tokens are encrypted in lib/dexcom.ts, per patient.
model DexcomConnection {
  patientId       String    @id
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encryptedTokens String
  expiresAt       DateTime
  importedAt      DateTime?
}

// One-use state, bound to an HttpOnly browser cookie; only hashes are stored. Keyed by the visit the
// patient pressed Connect on (§4.4), so the callback lands the import on that visit and does not have to
// guess; the connection the import creates is still per patient (§4.10).
model DexcomOAuthState {
  stateHash   String   @id
  browserHash String
  visitId     String
  visit       Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
}
