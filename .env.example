# Copy to .env and fill in. Never commit .env.
#
# Every variable below has a row in lib/config.ts, which checks them when the server starts (design §3.7).
# `npm run config:check` prints this list with what is set and what is wrong; add --production to see what a
# production deployment would make of it. Three levels:
#
#   [required]     The app refuses to start in production without it. In development it only warns.
#   [recommended]  Production works without it, less well; the comment says how.
#   [optional]     A knob or one integration. Unset is silence.
#
# A value that is set but malformed — a `file:` database URL, a timeout of "soon", half a Twilio account — is
# treated like a missing required one.

# --- App ------------------------------------------------------------------------------------------------

# Postgres only (design §3.2). `docker compose up db` starts one with exactly these credentials; on AWS this is
# RDS. Without a Docker daemon, `bash scripts/dev-db.sh` starts a host Postgres instead and prints the URL.
# [required]
DATABASE_URL="postgresql://sweetspot:sweetspot@localhost:5432/sweetspot?schema=public"

# Public base URL of this deployment. Every patient and provider link is built from it, so a wrong value is an
# invite nobody can open. Must be https:// in production unless the host is localhost. ngrok's https URL when
# texting real phones.
# [required]
APP_URL="http://localhost:3000"

# Time zone the Sour one-pager reads times in, e.g. America/Los_Angeles. Defaults to the server's own zone.
# [optional]
SUMMARY_TZ=""

# Set by Next.js, not by you. `production` is what turns the checks above into a refusal to start.
# [optional]
# NODE_ENV="production"

# --- Provider sign-in (design §5.1) -------------------------------------------------------------------

# Signs the provider session cookie and hashes the one-time sign-in tokens: `openssl rand -base64 32`.
# Outside production lib/auth.ts falls back to a fixed development value, so `npm run dev` and the e2e suite
# need no setup; a deployment must supply its own (from SSM Parameter Store, §10.6) or nobody can sign in.
# AUTH_SECRET is the Auth.js v5 name; NEXTAUTH_SECRET is the v4 alias and either satisfies the check.
# [required]
AUTH_SECRET=""
# [optional] The v4 alias, for a deployment that already has one under the old name. Set one or the other.
# NEXTAUTH_SECRET=""

# Divert every outgoing email to files in this directory, one per message, instead of sending it — which is
# what you want locally even if AWS credentials happen to be in your environment. `npm run mail` reads them.
# Never set it in a deployed environment: nothing is delivered, and the sign-in links in those files are
# credentials (§10.6). The check refuses it in production for that reason.
# [optional]
DEV_MAIL_DIR=".mail"

# --- Background jobs (design §3.4) --------------------------------------------------------------------
# Sour and every notification are rows in `Job`, drained by POST /api/jobs/run. Set JOBS_SECRET and have
# whatever calls that route (EventBridge Scheduler in AWS) send it as `Authorization: Bearer <secret>`.
# `npm run jobs:drain` drains by hand. See docs/JOBS.md.

# [recommended] Without it the route refuses and the app drains the queue itself after each request, which is
# what local development, the demo and the e2e suite do.
JOBS_SECRET=""

# Force either behaviour instead of deciding from JOBS_SECRET: inline | scheduled.
# [optional]
JOBS_RUNNER=""

# --- Uploaded files (design §3.3, §9.1) -------------------------------------------------------------------
# The bytes of an uploaded export never go in the database. lib/storage.ts puts them in S3 where a bucket is
# configured and on the filesystem where one is not, and the `Upload` row keeps the key. The 20 MB cap and the
# type sniffing in lib/uploads.ts are not configurable.

# [recommended] Private bucket for the raw files. Without it they go to the local filesystem, which a
# deployment loses on every redeploy and never shares between instances.
UPLOADS_BUCKET=""

# Region of that bucket, when it differs from the default region.
# [optional]
UPLOADS_REGION=""

# Encrypt objects with your own KMS key (SSE-KMS) instead of the bucket default (SSE-S3).
# [optional]
UPLOADS_KMS_KEY_ID=""

# Where the filesystem backend writes. Default data/uploads/, which .gitignore already covers.
# [optional]
UPLOADS_DIR=""

# Force a backend instead of deciding from UPLOADS_BUCKET: s3 | local.
# [optional]
STORAGE_BACKEND=""

# --- Model ----------------------------------------------------------------------------------------------
# Bedrock Runtime (OpenAI-compatible endpoint, from the AWS workshop). Without a key, Sweetie and Sour answer
# from their scripted paths and the page says so (design §6.3, §11.3) — which is how the e2e suite runs, so
# none of this is required to start.

# Short-term Bedrock API keys are scoped to the region they were generated in. Match the region here to the
# console you created the key in, or every call returns 401 "Credential should be scoped to a valid region".
# [optional]
AWS_REGION="us-east-1"

# [recommended] Without it the OpenAI SDK's own default endpoint is used, which is not Bedrock.
OPENAI_BASE_URL="https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1"

# [recommended] Bedrock API key (the AWS_BEARER_TOKEN_BEDROCK value), not an OpenAI key.
OPENAI_API_KEY=""

# [recommended] Without it lib/llm.ts falls back to openai.gpt-5.5, which may not be enabled for your account.
BEDROCK_OPENAI_MODEL_ID="global.openai.gpt-5.6-terra"

# How long a model call may take and how long a dead gateway is left alone (design §3.5). The defaults below are
# what the app uses when these are unset, so leave them out unless you are tuning. After LLM_CIRCUIT_THRESHOLD
# failed calls in a row, lib/llm.ts stops calling for LLM_CIRCUIT_COOLDOWN_MS and Sweetie answers from its
# scripted path with a note on the page; one probe call after the cooldown decides whether to resume.
# [optional]
LLM_TIMEOUT_MS="20000"                     # per HTTP attempt; there is one retry for transient failures
LLM_CIRCUIT_THRESHOLD="3"
LLM_CIRCUIT_COOLDOWN_MS="60000"

# --- Sending the link -----------------------------------------------------------------------------------
# Each channel is optional; with none configured the invite link is shown on screen instead of sent (design §8).

# AWS credentials (sponsor credits). Enable SES email and SNS SMS when set; leave them unset on AWS, where the
# task role supplies credentials. Same names the AWS SDK and CLI read.
# [optional]
AWS_DEFAULT_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""                       # temporary credentials only

# Email. Auto-picks resend if RESEND_API_KEY is set, else ses if AWS keys are set.
# SES sandbox: EMAIL_FROM and every recipient must be verified identities in the SES console (verification is an
# email link).
# [optional]
EMAIL_PROVIDER=""                          # force a backend: resend | ses
EMAIL_FROM="you@example.com"               # or "Sweet Spot <you@example.com>"
RESEND_API_KEY=""
AWS_SES_REGION=""                          # only when SES lives in another region than the default

# SMS. Auto-picks twilio if TWILIO_ACCOUNT_SID is set, else sns if AWS keys are set.
# SNS sandbox: recipients must be verified in the SNS console; US destinations also need a registered
# origination number.
# [optional]
SMS_PROVIDER=""                            # force a backend: twilio | sns
TWILIO_ACCOUNT_SID=""                      # starts with AC; needs the two below
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""                             # +15551234567, or a Messaging Service SID
AWS_SNS_REGION=""                          # only when SNS lives in another region than the default
SNS_ORIGINATION_NUMBER=""                  # +15551234567

# Delivery status (design §8.1). The SNS topics whose notifications POST /api/notifications/sns will act on:
# SES's bounce/complaint topic, and the topic carrying inbound texts so a STOP is honored. Nothing is trusted
# until a topic is listed here, however well signed it is. docs/NOTIFICATIONS.md is the setup.
# [optional]
SNS_TOPIC_ARNS=""                          # comma separated, e.g. arn:aws:sns:us-east-1:123456789012:sweetspot-ses-events
SES_CONFIGURATION_SET=""                   # SES configuration set that publishes those events

# --- Dexcom ---------------------------------------------------------------------------------------------
# OAuth against the Dexcom sandbox or against production, same code either way (design §9.2). The group is
# optional — uploads work without any of it — but a partial set is not a lighter version of it: lib/dexcom.ts
# reads one as "not connected", which hides the typo that caused it. docs/DEXCOM.md is the setup, the
# production approval application, and how the switch is thrown.

# sandbox | production. Sandbox is the default and stays the default until Dexcom approves the application;
# production reads a real person's glucose, so nothing but this variable should be able to reach it.
# [optional]
DEXCOM_ENV=""

# The application's credentials. Used for whichever environment has no pair of its own below, which is all a
# deployment with one Dexcom application needs.
# [optional]
DEXCOM_CLIENT_ID=""
DEXCOM_CLIENT_SECRET=""

# Sandbox and production are separate applications on Dexcom's side with separate credentials. Set these to
# hold both at once, so moving to production is DEXCOM_ENV and nothing else.
# [optional]
DEXCOM_SANDBOX_CLIENT_ID=""
DEXCOM_SANDBOX_CLIENT_SECRET=""
DEXCOM_PRODUCTION_CLIENT_ID=""
DEXCOM_PRODUCTION_CLIENT_SECRET=""

# This deployment's callback, which Dexcom must have registered for the application being used. https://,
# or http:// on localhost — and https:// always when DEXCOM_ENV=production.
# [optional]
DEXCOM_REDIRECT_URI=""                     # http://localhost:3000/api/dexcom/callback, or your APP_URL + that path

# The KMS key the stored refresh tokens are encrypted with (design §4.10, §10.1). Required on a deployment
# with Dexcom configured; without it lib/dexcom.ts derives a local key from the client secret, which is for
# development and the demo. An ARN names its own region; an id or alias uses the default region.
# [optional]
DEXCOM_TOKEN_KMS_KEY_ID=""                 # alias/sweetspot-dexcom-tokens, or the key's uuid or ARN

# No longer how the host is chosen — DEXCOM_ENV is. Kept so that a deployment which pinned it is checked
# against the switch instead of ignored: set it, and it has to agree with DEXCOM_ENV.
# [optional]
DEXCOM_BASE_URL=""                         # https://sandbox-api.dexcom.com
