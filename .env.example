# Copy to .env and fill in. Never commit .env.

# Bedrock Runtime (OpenAI-compatible endpoint, from the AWS workshop)
# Short-term Bedrock API keys are scoped to the region they were generated in. Match the region here to
# the console you created the key in, or every call returns 401 "Credential should be scoped to a valid region".
AWS_REGION="us-east-1"
OPENAI_BASE_URL="https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1"
OPENAI_API_KEY=""                          # Bedrock API key (the AWS_BEARER_TOKEN_BEDROCK value), not an OpenAI key
BEDROCK_OPENAI_MODEL_ID="global.openai.gpt-5.6-terra"

# How long a model call may take and how long a dead gateway is left alone (design 3.5). The defaults below are
# what the app uses when these are unset, so leave them out unless you are tuning. After LLM_CIRCUIT_THRESHOLD
# failed calls in a row, lib/llm.ts stops calling for LLM_CIRCUIT_COOLDOWN_MS and Sweetie answers from its
# scripted path with a note on the page; one probe call after the cooldown decides whether to resume.
LLM_TIMEOUT_MS="20000"                     # per HTTP attempt; there is one retry for transient failures
LLM_CIRCUIT_THRESHOLD="3"
LLM_CIRCUIT_COOLDOWN_MS="60000"

# App
# Postgres only (design §3.2). `docker compose up db` starts one with exactly these credentials; on AWS this is RDS.
# Without a Docker daemon, `bash scripts/dev-db.sh` starts a host Postgres instead and prints the URL to use.
DATABASE_URL="postgresql://sweetspot:sweetspot@localhost:5432/sweetspot?schema=public"
APP_URL="http://localhost:3000"            # ngrok https URL when texting real phones

# Provider sign-in (design §5.1). AUTH_SECRET signs the session cookie and hashes the one-time sign-in tokens:
# `openssl rand -base64 32`. Local development falls back to a fixed development value if this is unset; a
# deployment must set it (from SSM Parameter Store, §10.6) or the app refuses to sign anyone in.
AUTH_SECRET=""
# Where sign-in links go when no email provider below is configured: a file per message, read with `npm run mail`.
# Never set this in a deployed environment — the links in it are credentials.
DEV_MAIL_DIR=".mail"

# --- Sending the link. Each channel is optional; unconfigured channels show the link on screen instead. ---

# AWS (sponsor credits). Enables SES email and SNS SMS when set. Same names the AWS SDK and CLI read.
AWS_DEFAULT_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# Email. Auto-picks resend if RESEND_API_KEY is set, else ses if AWS keys are set. Force with EMAIL_PROVIDER=resend|ses.
# SES sandbox: EMAIL_FROM and every recipient must be verified identities in the SES console (verification is an email link).
EMAIL_FROM="you@example.com"
RESEND_API_KEY=""

# SMS. Auto-picks twilio if TWILIO_ACCOUNT_SID is set, else sns if AWS keys are set. Force with SMS_PROVIDER=twilio|sns.
# SNS sandbox: recipients must be verified in the SNS console; US destinations also need a registered origination number.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
SNS_ORIGINATION_NUMBER=""
