# Copy to .env and fill in. Never commit .env.

# Bedrock (OpenAI-compatible endpoint, from the AWS workshop)
OPENAI_BASE_URL="https://bedrock-mantle.us-east-2.api.aws/openai/v1"
OPENAI_API_KEY=""                          # Bedrock API key, not an OpenAI key
BEDROCK_OPENAI_MODEL_ID="openai.gpt-5.5"   # or openai.gpt-5.4

# App
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"            # ngrok https URL when texting real phones

# Twilio SMS (optional; if unset the booking page shows the link instead).
# A trial account can only text numbers verified in the Twilio console.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Resend email (optional). Free tier sends from onboarding@resend.dev to the account owner's own address.
RESEND_API_KEY=""
EMAIL_FROM="Sweet Spot <onboarding@resend.dev>"
